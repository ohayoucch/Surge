#OS27 Siri AI

# ============================================================
# ⚠️ 节点不支持 UDP 时(如 snell/部分中转)
# apple-relay 优先用 QUIC(UDP)。若节点不支持 UDP 转发,
# 需在主配置 RULE-SET 之前额外加两条,强制 QUIC 回退 TCP:
#   AND,((DOMAIN-KEYWORD,apple-relay),(PROTOCOL,QUIC)),REJECT-NO-DROP
#   AND,((IP-CIDR,17.248.0.0/16,no-resolve),(PROTOCOL,QUIC)),REJECT-NO-DROP
# (REJECT-NO-DROP 主动拒绝 QUIC 让客户端秒回退 TCP;节点支持 UDP 则不需要。)
#
# 注意:IP-CIDR,17.248.0.0/16 会把该整段 Apple IP 导向代理
# (含少量其他 Apple 服务),是为覆盖 ChatGPT 的取舍。
# ============================================================

# Apple Intelligence 推理中继
DOMAIN-KEYWORD,apple-relay

# Siri 后端 / 资源
DOMAIN-SUFFIX,siri.apple.com
DOMAIN-SUFFIX,smoot.apple.com
DOMAIN-SUFFIX,guzzoni.apple.com
DOMAIN,api-siri-prod.apple.com
DOMAIN-SUFFIX,aaplimg.com
DOMAIN-SUFFIX,gspe1-ssl.ls.apple.com
DOMAIN-SUFFIX,cp4.cloudflare.com

# Apple 账号/地区认证 (出口IP参与服务区判定, 必须同走海外, 否则 Siri AI 整体失效)
DOMAIN,gsa.apple.com
DOMAIN-SUFFIX,ess.apple.com
DOMAIN-SUFFIX,gateway.icloud.com
DOMAIN-SUFFIX,unlinkability.apple.com
DOMAIN-SUFFIX,pat-issuer.cloudflare.com
DOMAIN,setup.icloud.com
DOMAIN,aidc.apple.com
DOMAIN,mask-api.icloud.com

# ChatGPT 扩展中继 apple-relay.apple.com 的 Apple 自有 IP 段
# (它用真实IP直发QUIC, 域名规则抓不到, 必须按IP兜底)
IP-CIDR,17.248.0.0/16,no-resolve
